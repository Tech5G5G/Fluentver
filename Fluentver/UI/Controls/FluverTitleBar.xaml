<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Fluver.UI.Controls.FluverTitleBar"
    x:DefaultBindMode="OneWay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fluver.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:Fluver.UI"
    xmlns:strings="using:Fluver.Strings"
    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    xmlns:is11="http://schemas.microsoft.com/winfx/2006/xaml/presentation?ui:WindowsVersionCondition(11)"
    xmlns:is10="http://schemas.microsoft.com/winfx/2006/xaml/presentation?ui:WindowsVersionCondition(10)"
    mc:Ignorable="d">
    <UserControl.Resources>
        <animatedvisuals:AnimatedSettingsVisualSource x:Key="SettingsVisualSource" />
        <animatedvisuals:AnimatedBackVisualSource x:Key="BackVisualSource" />
    </UserControl.Resources>

    <Grid Height="{x:Bind DimensionProvider.Height}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WindowActivated" />

                <VisualState x:Name="WindowDeactivated">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{x:Bind InvertBool(IsSettingsButtonActive)}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="TitleText.Foreground" Value="{ThemeResource TitleBarCaptionButtonInactiveForegroundColor}" />
                        <Setter Target="SettingsIcon.Foreground" Value="{ThemeResource TitleBarCaptionButtonInactiveForegroundColor}" />
                        <Setter Target="FallbackSettingsIcon.Foreground" Value="{ThemeResource TitleBarCaptionButtonInactiveForegroundColor}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <VisualStateGroup>
                <VisualState x:Name="Settings" />

                <VisualState x:Name="Back">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{x:Bind IsSettingsOpen}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SettingsButton.(ToolTipService.ToolTip)" Value="{strings:ResourcesExtension Key=SettingsButtonBackTooltip}" />
                        <Setter Target="SettingsIcon.Source" Value="{StaticResource BackVisualSource}" />
                        <Setter Target="FallbackSettingsIcon.Glyph" Value="&#xE72B;" />
                        <Setter Target="FallbackSettingsIcon.FontSize" Value="12" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{x:Bind DoubleToGridLength(DimensionProvider.LeftInset)}" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="{x:Bind DoubleToGridLength(DimensionProvider.RightInset)}" />
        </Grid.ColumnDefinitions>

        <Border x:Name="DragRegion" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="14,0,0,0" Grid.Column="1">
            <TextBlock x:Name="TitleText" Text="{x:Bind Title}" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
        </Border>

        <Button x:Name="SettingsButton" x:Uid="SettingsButton"
                CornerRadius="0" BorderThickness="0" Background="Transparent"
                Width="46" VerticalAlignment="Stretch"
                is11:FocusVisualMargin="0,1,0,0" is10:FocusVisualMargin="0"
                Grid.Column="2" ToolTipService.Placement="Bottom"
                Click="OnSettingsButtonClick"
                Loaded="OnSettingsButtonLoaded" Unloaded="OnSettingsButtonUnloaded">
            <AnimatedIcon x:Name="SettingsIcon"
                          Source="{StaticResource SettingsVisualSource}"
                          Foreground="{ThemeResource TitleBarCaptionButtonForegroundColor}"
                          Width="16" Height="16">
                <AnimatedIcon.FallbackIconSource>
                    <FontIconSource x:Name="FallbackSettingsIcon"
                                    Glyph="&#xE713;" FontSize="14"
                                    Foreground="{ThemeResource TitleBarCaptionButtonForegroundColor}" />
                </AnimatedIcon.FallbackIconSource>
            </AnimatedIcon>
        </Button>
    </Grid>
</UserControl>
