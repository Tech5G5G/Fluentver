<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Fluver.UI.Controls.FluverTitleBar"
    x:DefaultBindMode="OneWay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fluver.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:Fluver.UI"
    xmlns:strings="using:Fluver.Strings"
    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    xmlns:is11="http://schemas.microsoft.com/winfx/2006/xaml/presentation?ui:WindowsVersionCondition(11)"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <x:Boolean x:Key="IsHighContrastEnabled">False</x:Boolean>

                    <x:String x:Key="ChromeCloseGlyph">&#xE8BB;</x:String>
                    <x:String x:Key="SettingsGlyph">&#xE713;</x:String>
                    <x:String x:Key="BackGlyph">&#xE72B;</x:String>

                    <Thickness x:Key="TitleBarPadding">14,0,0,0</Thickness>
                    <StaticResource x:Key="TitleBarBackground" ResourceKey="ControlFillColorTransparentBrush" />
                    <StaticResource x:Key="TitleBarInactiveBackground" ResourceKey="ControlFillColorTransparentBrush" />
                    <StaticResource x:Key="TitleBarForeground" ResourceKey="SystemControlForegroundBaseHighBrush" />
                    <StaticResource x:Key="TitleBarInactiveForeground" ResourceKey="TextFillColorDisabledBrush" />

                    <Thickness x:Key="CaptionButtonMargin">0</Thickness>
                    <StaticResource x:Key="CaptionButtonForeground" ResourceKey="SystemControlForegroundBaseHighBrush" />
                    <StaticResource x:Key="CaptionButtonInactiveForeground" ResourceKey="TextFillColorDisabledBrush" />

                    <StaticResource x:Key="ButtonBackground" ResourceKey="ControlFillColorTransparentBrush" />
                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondary" />
                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiary" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <x:Boolean x:Key="IsHighContrastEnabled">False</x:Boolean>

                    <x:String x:Key="ChromeCloseGlyph">&#xE8BB;</x:String>
                    <x:String x:Key="SettingsGlyph">&#xE713;</x:String>
                    <x:String x:Key="BackGlyph">&#xE72B;</x:String>

                    <Thickness x:Key="TitleBarPadding">14,0,0,0</Thickness>
                    <StaticResource x:Key="TitleBarBackground" ResourceKey="ControlFillColorTransparentBrush" />
                    <StaticResource x:Key="TitleBarInactiveBackground" ResourceKey="ControlFillColorTransparentBrush" />
                    <StaticResource x:Key="TitleBarForeground" ResourceKey="SystemControlForegroundBaseHighBrush" />
                    <StaticResource x:Key="TitleBarInactiveForeground" ResourceKey="TextFillColorDisabledBrush" />

                    <Thickness x:Key="CaptionButtonMargin">0</Thickness>
                    <StaticResource x:Key="CaptionButtonForeground" ResourceKey="SystemControlForegroundBaseHighBrush" />
                    <StaticResource x:Key="CaptionButtonInactiveForeground" ResourceKey="TextFillColorDisabledBrush" />

                    <StaticResource x:Key="ButtonBackground" ResourceKey="ControlFillColorTransparentBrush" />
                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondary" />
                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiary" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <x:Boolean x:Key="IsHighContrastEnabled">True</x:Boolean>

                    <x:String x:Key="ChromeCloseGlyph">&#xEF2C;</x:String>
                    <x:String x:Key="SettingsGlyph">&#xF8B0;</x:String>
                    <x:String x:Key="BackGlyph">&#xF0D5;</x:String>

                    <Thickness x:Key="TitleBarPadding">9,0,0,0</Thickness>
                    <SolidColorBrush x:Key="TitleBarBackground" Color="{ThemeResource SystemColorActiveCaptionColor}" />
                    <SolidColorBrush x:Key="TitleBarInactiveBackground" Color="{ThemeResource SystemColorInactiveCaptionColor}" />
                    <SolidColorBrush x:Key="TitleBarForeground" Color="{ThemeResource SystemColorCaptionTextColor}" />
                    <SolidColorBrush x:Key="TitleBarInactiveForeground" Color="{ThemeResource SystemColorInactiveCaptionTextColor}" />

                    <Thickness x:Key="CaptionButtonMargin">1,1,0,1</Thickness>
                    <StaticResource x:Key="CaptionButtonForeground" ResourceKey="ButtonForegroundThemeBrush" />
                    <StaticResource x:Key="CaptionButtonInactiveForeground" ResourceKey="ButtonForegroundThemeBrush" />

                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SystemControlHighlightAccentBrush" />
                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SystemControlHighlightAccentBrush" />
                    <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="SystemControlHighlightAltAccentBrush" />
                    <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="SystemControlHighlightAltAccentBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Color x:Key="CloseButtonBackgroundColor">#C42B1C</Color>
            <Color x:Key="CloseButtonTransparentBackgroundColor">#00C42B1C</Color>
            <Color x:Key="CloseButtonForegroundColor">White</Color>

            <animatedvisuals:AnimatedSettingsVisualSource x:Key="SettingsVisualSource" />
            <animatedvisuals:AnimatedBackVisualSource x:Key="BackVisualSource" />

            <Style x:Key="CaptionButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Foreground" Value="{ThemeResource CaptionButtonForeground}" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Margin" Value="{ThemeResource CaptionButtonMargin}" />
                <Setter Property="Width" Value="46" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="FocusVisualMargin" Value="0" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="ToolTipService.Placement" Value="Bottom" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="LayoutRoot" Background="{ThemeResource TitleBarBackground}" Height="30" is11:Margin="0,1,0,0">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Active" />

                <VisualState x:Name="Inactive">
                    <VisualState.StateTriggers>
                        <ui:MultiStateTrigger ConditionOne="{x:Bind Window.IsActive}"
                                              ConditionTwo="{x:Bind Appearance.IsAccented}"
                                              InvertedConditions="One,Two" />

                        <ui:MultiStateTrigger ConditionOne="{x:Bind Window.IsActive}"
                                              ConditionTwo="{ThemeResource IsHighContrastEnabled}"
                                              InvertedConditions="One" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="LayoutRoot.Background" Value="{ThemeResource TitleBarInactiveBackground}" />
                        <Setter Target="TitleText.Foreground" Value="{ThemeResource TitleBarInactiveForeground}" />
                        <Setter Target="SettingsButton.Foreground" Value="{ThemeResource CaptionButtonInactiveForeground}" />
                        <Setter Target="CloseButton.Foreground" Value="{ThemeResource CaptionButtonInactiveForeground}" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="ActiveAccented">
                    <VisualState.StateTriggers>
                        <ui:MultiStateTrigger ConditionOne="{x:Bind Window.IsActive}"
                                              ConditionTwo="{x:Bind Appearance.IsAccented}"
                                              ConditionThree="{ThemeResource IsHighContrastEnabled}"
                                              InvertedConditions="Three" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="LayoutRoot.Background" Value="{x:Bind Appearance.AccentColor}" />
                        <Setter Target="LayoutRoot.RequestedTheme" Value="{x:Bind Appearance.AccentTheme}" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="InactiveAccented">
                    <VisualState.StateTriggers>
                        <ui:MultiStateTrigger ConditionOne="{x:Bind Window.IsActive}"
                                              ConditionTwo="{x:Bind Appearance.IsAccented}"
                                              ConditionThree="{ThemeResource IsHighContrastEnabled}"
                                              InvertedConditions="One,Three" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="LayoutRoot.Background" Value="{ThemeResource TitleBarInactiveBackground}" />
                        <Setter Target="TitleText.Foreground" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                        <Setter Target="SettingsButton.Foreground" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                        <Setter Target="CloseButton.Foreground" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <VisualStateGroup>
                <VisualState x:Name="Settings" />

                <VisualState x:Name="Back">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{x:Bind IsSettingsOpen}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SettingsButtonToolTip.Content" Value="{x:Bind strings:Resources.SettingsButtonBackToolTip, Mode=OneTime}" />

                        <Setter Target="FallbackSettingsIcon.Glyph" Value="{ThemeResource BackGlyph}" />
                        <Setter Target="FallbackSettingsIconViewbox.Width" Value="12" />
                        <Setter Target="FallbackSettingsIconViewbox.Height" Value="12" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <VisualStateGroup>
                <VisualState x:Name="AnimatedSettings" />

                <VisualState x:Name="AnimatedBack">
                    <VisualState.StateTriggers>
                        <ui:MultiStateTrigger ConditionOne="{x:Bind IsSettingsOpen}"
                                              ConditionTwo="{ThemeResource IsHighContrastEnabled}"
                                              InvertedConditions="Two" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SettingsIcon.Source" Value="{StaticResource BackVisualSource}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <VisualStateGroup>
                <VisualState x:Name="StaticIcons" />

                <VisualState x:Name="AnimatedIcons">
                    <VisualState.StateTriggers>
                        <ui:MultiStateTrigger ConditionOne="{x:Bind AnimateIcons}"
                                              ConditionTwo="{ThemeResource IsHighContrastEnabled}"
                                              InvertedConditions="Two" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SettingsIcon.Visibility" Value="Visible" />
                        <Setter Target="FallbackSettingsIconViewbox.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border x:Name="DragRegion"
                Background="Transparent"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Padding="{ThemeResource TitleBarPadding}">
            <TextBlock x:Name="TitleText"
                       Text="{x:Bind Title}"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{ThemeResource TitleBarForeground}"
                       VerticalAlignment="Center"
                       HighContrastAdjustment="None"
                       Style="{StaticResource CaptionTextBlockStyle}" />
        </Border>

        <Button x:Name="SettingsButton"
                Command="{x:Bind SettingsCommand}"
                CommandParameter="{x:Bind SettingsCommandParameter}"
                Style="{StaticResource CaptionButtonStyle}"
                Grid.Column="1"
                Click="OnSettingsButtonClick"
                Loaded="OnSettingsButtonLoaded" Unloaded="OnSettingsButtonUnloaded">
            <ToolTipService.ToolTip>
                <ToolTip x:Name="SettingsButtonToolTip" x:Uid="SettingsButtonToolTip" RequestedTheme="{x:Bind Theme}" />
            </ToolTipService.ToolTip>

            <Grid>
                <AnimatedIcon x:Name="SettingsIcon" x:Load="False"
                              Source="{StaticResource SettingsVisualSource}"
                              Width="16" Height="16"
                              Visibility="Collapsed"
                              HighContrastAdjustment="None"
                              Loaded="OnSettingsIconLoaded" />

                <Viewbox x:Name="FallbackSettingsIconViewbox" Width="14" Height="14">
                    <FontIcon x:Name="FallbackSettingsIcon" Glyph="{ThemeResource SettingsGlyph}" HighContrastAdjustment="None" />
                </Viewbox>
            </Grid>
        </Button>

        <Button x:Name="CloseButton" Style="{StaticResource CaptionButtonStyle}" Grid.Column="2" Click="OnCloseButtonClick">
            <Button.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Default">
                            <SolidColorBrush x:Key="ButtonBackground" Color="{StaticResource CloseButtonTransparentBackgroundColor}" />
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource CloseButtonBackgroundColor}" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{StaticResource CloseButtonBackgroundColor}" Opacity="0.9" />
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{StaticResource CloseButtonForegroundColor}" />
                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{StaticResource CloseButtonForegroundColor}" Opacity="0.7" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Light">
                            <SolidColorBrush x:Key="ButtonBackground" Color="{StaticResource CloseButtonTransparentBackgroundColor}" />
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource CloseButtonBackgroundColor}" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{StaticResource CloseButtonBackgroundColor}" Opacity="0.9" />
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{StaticResource CloseButtonForegroundColor}" />
                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{StaticResource CloseButtonForegroundColor}" Opacity="0.7" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="HighContrast" />
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </Button.Resources>

            <ToolTipService.ToolTip>
                <ToolTip x:Uid="CloseButtonToolTip" RequestedTheme="{x:Bind Theme}" />
            </ToolTipService.ToolTip>

            <Viewbox Width="10" Height="10">
                <FontIcon Glyph="{ThemeResource ChromeCloseGlyph}" HighContrastAdjustment="None" />
            </Viewbox>
        </Button>
    </Grid>
</UserControl>
