<?xml version="1.0" encoding="utf-8"?>
<controls:WindowEx
    x:Class="Fluver.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fluver"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="using:Fluver.UI"
    xmlns:ui2="using:CommunityToolkit.WinUI"
    xmlns:controls="using:Fluver.UI.Controls"
    xmlns:controls2="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d"
    Title="Fluver"
    Width="480" Height="578"
    MinWidth="480" MaxWidth="480"
    DoubleClickToMaximize="False"
    Activated="OnActivated" Closed="OnClosed">

    <Grid Background="Transparent" VerticalAlignment="Top" SizeChanged="OnSizeChanged" PointerPressed="OnPointerPressed">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:FluverTitleBar x:Name="TitleBar"
                                 IsBackButtonVisible="{x:Bind ViewModel.IsSettingsOpen, Mode=OneWay}"
                                 SettingsCommand="{x:Bind ViewModel.SettingsCommand}" />

        <Frame x:Name="ContentFrame" Grid.Row="1" />
    </Grid>
</controls:WindowEx>
