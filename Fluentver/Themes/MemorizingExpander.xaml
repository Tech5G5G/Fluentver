<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Fluver.UI.Controls">

    <Style TargetType="controls:MemorizingExpander" BasedOn="{StaticResource DefaultMemorizingExpanderStyle}" />
    <Style x:Key="DefaultMemorizingExpanderStyle" TargetType="controls:MemorizingExpander">
        <Setter Property="IsExpanded" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="12" />
    </Style>
</ResourceDictionary>
